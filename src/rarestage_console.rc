#include <windows.h>

1 24 "rarestage.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,10,8,0
 PRODUCTVERSION 0,10,8,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "AntNetwork, L.L.C."
      VALUE "FileDescription", "RareStage Console"
      VALUE "FileVersion", "0.10.8.0"
      VALUE "InternalName", "RareStageConsole"
      VALUE "LegalCopyright", "Copyright (C) 2026 AntNetwork, L.L.C."
      VALUE "OriginalFilename", "RareStageConsole.exe"
      VALUE "ProductName", "RareStage"
      VALUE "ProductVersion", "0.10.8"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
